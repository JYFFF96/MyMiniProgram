.top{display:flex;justify-content:space-between;align-items:center;margin:18rpx 0 34rpx}.title{font-size:44rpx;font-weight:800;margin-bottom:8rpx}.muted{font-size:24rpx}.add{width:78rpx;height:78rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#edaa82;color:#fff;font-size:45rpx}.album-grid{display:grid;grid-template-columns:1fr 1fr;gap:22rpx}.album{overflow:hidden}.cover{height:240rpx;display:flex;align-items:center;justify-content:center;font-size:76rpx;position:relative}.cover.peach{background:#f8d7c2}.cover.pink{background:#f4d9db}.cover.green{background:#dce8db}.cover.yellow{background:#f4e7bd}.stack{position:absolute;inset:14rpx;border:2rpx solid rgba(255,255,255,.55);border-radius:22rpx}.album-info{padding:22rpx}.album-name{font-size:28rpx;font-weight:700;display:block}.count{font-size:21rpx;color:#a89d95;margin-top:7rpx;display:block}
