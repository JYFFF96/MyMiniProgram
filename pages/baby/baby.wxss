.baby-card{text-align:center;padding:42rpx 28rpx}.baby-avatar{width:146rpx;height:146rpx;margin:0 auto 18rpx;border-radius:50%;background:#ffe4d2;display:flex;align-items:center;justify-content:center;font-size:76rpx}.baby-name{font-size:40rpx;font-weight:800;margin-bottom:8rpx}.baby-card .muted{font-size:23rpx}.stats{display:flex;margin-top:38rpx;padding-top:30rpx;border-top:1rpx solid #f0e8e2}.stat{flex:1}.stat text{display:block}.stat text:first-child{font-size:34rpx;font-weight:700}.stat text:last-child{font-size:21rpx;color:#aa9f97;margin-top:6rpx}.milestone-title{margin:42rpx 0 18rpx}.milestones{padding:0 24rpx}.milestone{display:flex;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #f2ebe7}.milestone:last-child{border:0}.m-icon{width:74rpx;height:74rpx;border-radius:22rpx;background:#fff0e7;display:flex;align-items:center;justify-content:center;font-size:36rpx;margin-right:20rpx}.m-main{flex:1}.m-main text{display:block}.m-main text:first-child{font-size:27rpx;font-weight:600}.m-main text:last-child{font-size:20rpx;color:#aaa099;margin-top:6rpx}.arrow{color:#c5bbb4;font-size:40rpx}.edit-btn{margin-top:30rpx;background:#fff;color:#d98a62;border-radius:999rpx;border:1rpx solid #f0cfbc}
