<view class="container">
  <view class="baby-card card">
    <view class="baby-avatar">👶</view>
    <view class="baby-name">{{baby.name}}</view>
    <view class="muted">{{baby.birthday}} · {{baby.zodiac}} · {{baby.age}}</view>
    <view class="stats">
      <block wx:for="{{stats}}" wx:key="label"><view class="stat"><text>{{item.value}}</text><text>{{item.label}}</text></view></block>
    </view>
  </view>
  <view class="section-title milestone-title">成长里程碑</view>
  <view class="card milestones">
    <block wx:for="{{milestones}}" wx:key="date">
      <view class="milestone"><view class="m-icon">{{item.icon}}</view><view class="m-main"><text>{{item.title}}</text><text>{{item.date}}</text></view><text class="arrow">›</text></view>
    </block>
  </view>
  <button class="edit-btn">编辑宝宝资料</button>
</view>
