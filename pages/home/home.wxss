.hero{padding:34rpx;display:flex;justify-content:space-between;align-items:center;background:linear-gradient(145deg,#fff,#fff0e4);margin-bottom:46rpx}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#d7a184}.hello{font-size:42rpx;font-weight:800;margin:10rpx 0}.days{font-size:25rpx;color:#9a8e86}.days text{color:#df8f65;font-weight:700}.avatar{width:112rpx;height:112rpx;border-radius:50%;background:#ffe3cf;display:flex;align-items:center;justify-content:center;font-size:58rpx}.timeline-title{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:22rpx}.timeline-title .muted{font-size:22rpx;margin-bottom:24rpx}.moment{display:flex;position:relative}.date-col{width:132rpx;position:relative;flex:none;padding-top:8rpx}.date{font-size:25rpx;font-weight:700;display:block}.year{font-size:20rpx;color:#b2a69e}.dot{position:absolute;right:14rpx;top:22rpx;width:14rpx;height:14rpx;background:#edaa82;border:8rpx solid #fff0e6;border-radius:50%;z-index:2}.line{position:absolute;right:28rpx;top:44rpx;bottom:-28rpx;width:2rpx;background:#eadfd8}.moment-card{overflow:hidden;flex:1;margin-bottom:30rpx}.photo{height:260rpx;background:linear-gradient(135deg,#f7d6c1,#f6ede6);display:flex;align-items:center;justify-content:center;position:relative;font-size:84rpx}.photo.grid{background:linear-gradient(135deg,#e8d9c8,#f5ddc9)}.photo.single{background:linear-gradient(135deg,#dfe8df,#f2e5d1)}.photo-label{position:absolute;right:18rpx;bottom:16rpx;font-size:18rpx;background:rgba(255,255,255,.78);padding:8rpx 14rpx;border-radius:999rpx;color:#8a7d74}.moment-body{padding:24rpx}.tag{display:inline-block;padding:7rpx 14rpx;background:#fff0e6;color:#d8885e;border-radius:999rpx;font-size:20rpx}.moment-title{font-size:31rpx;font-weight:700;margin:14rpx 0 8rpx}.moment-text{font-size:25rpx;line-height:1.65;color:#776c65}
