.intro{margin:20rpx 0 34rpx}.title{font-size:44rpx;font-weight:800;margin-bottom:8rpx}.form{padding:28rpx}.upload{height:300rpx;border:3rpx dashed #e8cdbd;border-radius:24rpx;background:#fffaf7;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#8e8179;font-size:26rpx}.plus{width:80rpx;height:80rpx;border-radius:50%;background:#ffe7d8;color:#df8e63;display:flex;align-items:center;justify-content:center;font-size:48rpx;margin-bottom:14rpx}.hint{font-size:20rpx;color:#b9afa8;margin-top:8rpx}.preview{padding:18rpx;background:#fff3ea;border-radius:18rpx;margin-top:18rpx;color:#d88960;font-size:24rpx}.textarea{width:100%;height:200rpx;padding:28rpx 0;box-sizing:border-box;border-bottom:1rpx solid #f0e8e2;font-size:28rpx;line-height:1.6}.row{display:flex;justify-content:space-between;padding:28rpx 0;border-bottom:1rpx solid #f2ebe7;font-size:26rpx}.publish{margin-top:32rpx}.tip{text-align:center;color:#afa49d;font-size:20rpx;line-height:1.6;padding:24rpx 38rpx}
