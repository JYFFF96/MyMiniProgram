.profile{display:flex;align-items:center;margin:24rpx 6rpx 34rpx}.avatar{width:112rpx;height:112rpx;border-radius:50%;background:#ffe5d5;display:flex;align-items:center;justify-content:center;font-size:56rpx;margin-right:24rpx}.name{font-size:34rpx;font-weight:800;margin-bottom:8rpx}.profile .muted{font-size:23rpx}.memory{display:flex;padding:32rpx;margin-bottom:28rpx;align-items:center;text-align:center}.memory>view:not(.line){flex:1}.number,.unit{display:block}.number{font-size:34rpx;font-weight:800}.unit{font-size:21rpx;color:#a69b93;margin-top:7rpx}.line{width:1rpx;height:62rpx;background:#eee4de}.menu{padding:0 24rpx}.menu-row{display:flex;align-items:center;padding:25rpx 0;border-bottom:1rpx solid #f1e9e4}.menu-row:last-child{border:0}.menu-icon{width:70rpx;height:70rpx;border-radius:20rpx;background:#fff2ea;display:flex;align-items:center;justify-content:center;font-size:32rpx;margin-right:20rpx}.menu-main{flex:1}.menu-main text{display:block}.menu-main text:first-child{font-size:27rpx;font-weight:600}.menu-main text:last-child{font-size:20rpx;color:#aaa099;margin-top:5rpx}.arrow{font-size:38rpx;color:#c9bfb9}.footer{text-align:center;color:#b7aaa2;font-size:21rpx;line-height:1.8;padding:55rpx 40rpx}
